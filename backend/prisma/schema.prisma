generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  RETAILER
  ACCOUNTANT
}

enum PurchaseStatus {
  DRAFT
  RECEIVED
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum SaleStatus {
  UNPAID
  PARTIAL
  PAID
  CANCELLED
}

enum OrderStatus {
  PENDING
  CONVERTED
  REJECTED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  salesCreated    Sale[]     @relation("SaleCreatedBy")
  purchasesCreated Purchase[] @relation("PurchaseCreatedBy")

  // Agar role RETAILER hai, to is User ka apna ek Customer profile hota hai
  // jisse ye apne orders place karta hai
  customerProfile Customer?
}

model Medicine {
  id          String   @id @default(uuid())
  name        String
  category    String?
  unit        String   // e.g. "Box of 10 strips"
  mrp         Decimal  @default(0)
  rate        Decimal  @default(0) // wholesale rate
  lowStockAt  Int      @default(10)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  batches     Batch[]
  orderItems  OrderItem[]
}

model Batch {
  id           String   @id @default(uuid())
  medicine     Medicine @relation(fields: [medicineId], references: [id])
  medicineId   String
  batchNumber  String
  expiryDate   DateTime?
  purchaseRate Decimal  @default(0)
  mrp          Decimal  @default(0)
  quantity     Int      @default(0)
  createdAt    DateTime @default(now())

  purchaseItems PurchaseItem[]
  saleItems     SaleItem[]
  movements     StockMovement[]
}

model StockMovement {
  id        String   @id @default(uuid())
  batch     Batch    @relation(fields: [batchId], references: [id])
  batchId   String
  change    Int      // +ve for in, -ve for out
  reason    String   // PURCHASE, SALE, RETURN, DAMAGE, ADJUSTMENT
  refId     String?  // related sale/purchase id
  createdAt DateTime @default(now())
}

model Customer {
  id           String   @id @default(uuid())
  name         String
  phone        String?
  customerType String   @default("Retail")
  creditLimit  Decimal  @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Agar ye customer ek Retailer login bhi hai, to uske User account se link hota hai
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  sales  Sale[]
  orders Order[]
}

model Supplier {
  id        String   @id @default(uuid())
  name      String
  phone     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  purchases Purchase[]
}

model Purchase {
  id         String         @id @default(uuid())
  supplier   Supplier       @relation(fields: [supplierId], references: [id])
  supplierId String
  invoiceNo  String?
  status     PurchaseStatus @default(RECEIVED)
  total      Decimal        @default(0)
  paid       Decimal        @default(0)
  createdBy  User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt  DateTime       @default(now())

  items PurchaseItem[]
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  purchaseId String
  medicineId String
  batch      Batch    @relation(fields: [batchId], references: [id])
  batchId    String
  quantity   Int
  rate       Decimal
}

model Sale {
  id         String     @id @default(uuid())
  customer   Customer   @relation(fields: [customerId], references: [id])
  customerId String
  status     SaleStatus @default(UNPAID)
  total      Decimal    @default(0)
  paid       Decimal    @default(0)
  createdBy  User       @relation("SaleCreatedBy", fields: [createdById], references: [id])
  createdById String
  createdAt  DateTime   @default(now())

  items    SaleItem[]
  payments Payment[]
  order    Order?
}

model SaleItem {
  id         String  @id @default(uuid())
  sale       Sale    @relation(fields: [saleId], references: [id])
  saleId     String
  medicineId String
  batch      Batch   @relation(fields: [batchId], references: [id])
  batchId    String
  quantity   Int
  rate       Decimal
}

model Payment {
  id        String   @id @default(uuid())
  sale      Sale     @relation(fields: [saleId], references: [id])
  saleId    String
  amount    Decimal
  mode      String   @default("Cash")
  createdAt DateTime @default(now())
}

// Retailer jab order place karta hai, wo pehle yahan PENDING banta hai.
// Admin/Staff use "Bill Banao" (convert to Sale) ya "Reject" kar sakte hain.
model Order {
  id         String      @id @default(uuid())
  customer   Customer    @relation(fields: [customerId], references: [id])
  customerId String
  status     OrderStatus @default(PENDING)
  sale       Sale?       @relation(fields: [saleId], references: [id])
  saleId     String?     @unique
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items OrderItem[]
}

model OrderItem {
  id         String   @id @default(uuid())
  order      Order    @relation(fields: [orderId], references: [id])
  orderId    String
  medicine   Medicine @relation(fields: [medicineId], references: [id])
  medicineId String
  quantity   Int
}
