# Supabase se milega (Project Settings -> Database -> Connection string -> URI)
DATABASE_URL="postgresql://user:password@host:5432/postgres"

# Koi bhi lamba random secret text daal do (password jaisa, kisi ko mat batana)
JWT_SECRET="change-this-to-a-long-random-secret-string"

# Render is variable ko khud set karta hai, isko chhod do
PORT=4000

# Frontend ka URL (Vercel deploy karne ke baad milega, abhi ke liye * rakho)
CORS_ORIGIN="*"
